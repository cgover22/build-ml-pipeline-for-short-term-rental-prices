name: basic_cleaning
conda_env: conda.yml

entry_points:
  main:
    parameters:

      input_artifact:
        description: The dataset to be cleaned.
        type: string

      output_artifact:
        description: The cleaned dataset to be saved as an artifact.
        type: string

      output_type:
        description: The file type of the cleaned dataset.
        type: string

      output_description:
        description: A description of the cleaned dataset.
        type: string

      min_price:
        description: The minimum price for filtering the dataset.
        type: float

      max_price:
        description: The maximum price for filtering the dataset.
        type: float


    command: >-
        python run.py  --input_artifact {input_artifact}  --output_artifact {output_artifact}  --output_type {output_type}  --output_description {output_description}  --min_price {min_price}  --max_price {max_price} 
